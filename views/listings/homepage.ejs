<% layout("/layouts/boilerplate") %>
<div class="container-fluid p-0">
    <!-- Hero Section -->
    <div class="bg-dark text-white text-center p-5">
        <h1>Find Your Dream Property</h1>
        <p class="lead">Discover amazing deals and connect with trusted sellers.</p>
        <a href="/listings" class="btn btn-primary btn-lg">Explore Listings</a>
    </div>

    <!-- Features Section -->
    <div class="container my-5">
        <h2 class="text-center mb-4">Why Choose Us</h2>
        <div class="row text-center">
            <div class="col-md-4">
                <i class="bi bi-house-door-fill display-4 text-primary"></i>
                <h4>Wide Range of Properties</h4>
                <p>Browse listings from residential to commercial properties.</p>
            </div>
            <div class="col-md-4">
                <i class="bi bi-shield-check display-4 text-success"></i>
                <h4>Trusted Platform</h4>
                <p>Your safety and satisfaction are our top priorities.</p>
            </div>
            <div class="col-md-4">
                <i class="bi bi-speedometer2 display-4 text-warning"></i>
                <h4>Fast & Reliable</h4>
                <p>Quickly find properties that match your requirements.</p>
            </div>
        </div>
    </div>

    <!-- Testimonials Section -->
    <div class="bg-light py-5">
        <div class="container">
            <h2 class="text-center mb-4">What Our Users Say</h2>
            <div class="row">
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <p>"This platform made it easy to find my dream home. Highly recommended!"</p>
                            <p class="text-muted text-end">- John Doe</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <p>"I sold my property within days! Great service and excellent support."</p>
                            <p class="text-muted text-end">- Jane Smith</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <p>"Efficient, secure, and user-friendly. The best platform for real estate."</p>
                            <p class="text-muted text-end">- Alex Brown</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Call to Action -->
    <div class="bg-primary text-white text-center p-5">
        <h2>Ready to Buy or Sell?</h2>
        <p class="lead">Join thousands of users and make your transactions seamless.</p>
        <a href="/listings/new" class="btn btn-light btn-lg">Post a Listing</a>
    </div>
</div>